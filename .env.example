APP_NAME=imet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

IMET_OFFLINE_VERSION=DEV  # imet_launcher takes care of setting IMET_OFFLINE_VERSION correctly during release creation

WEB_PORT=83

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=ofac
DB_HOST=db
DB_PORT=5433
DB_DATABASE=imetdb
DB_USERNAME=default
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAPBOX_ACCESS_TOKEN=
PROTECTED_PLANET_API_KEY=

# docker
COMPOSER_GITHUB_TOKEN=
HTTP_PORT=
UID=1000
