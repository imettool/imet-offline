{
    "name": "andreamarelli/imet",
    "description": "Imet Offline Tool",
    "license": "GPL-3.0-only",
    "version": "3.0.0-rc.30",
    "require": {
        "php": ">=8.4",
        "ext-zip": "*",
        "andreamarelli/imet-core": "^3.1.3",
        "guzzlehttp/guzzle": "^7.9.3",
        "laravel/framework": "^12.20.0",
        "laravel/ui": "^4.6.1",
        "nativephp/electron": "1.2.0",
        "nativephp/laravel": "1.2.0",
        "nativephp/php-bin": "1.1.0",
        "nunomaduro/collision": "^8.8",
        "opcodesio/log-viewer": "^3.17.1",
        "spatie/laravel-csp": "^3.13.0",
        "spatie/laravel-ignition": "^2.9",
        "symfony/console" : "^7.2.7"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "3.6.0",
        "fakerphp/faker": "1.24.1",
        "larastan/larastan": "^3.7"
    },
    "repositories": {
        "andreamarelli/modular-forms": {
            "type": "vcs",
            "url": "https://github.com/andreamarelli/modular-forms"
        },
        "andreamarelli/imet-core": {
            "type": "vcs",
            "url": "https://github.com/andreamarelli/imet-core"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta",
            "php artisan log-viewer:publish"
        ],
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate --ansi"
        ],
        "native:serve": [
            "php artisan native:serve"
        ],
        "native:dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -k -c \"#93c5fd,#c4b5fd\" \"php artisan native:serve --no-interaction\" \"npm run dev\" --names=app,vite"
        ],
        "phpstan": "./vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit 512M"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
