{
    "name": "imettool/imet",
    "description": "Imet Offline Tool",
    "license": "GPL-3.0-only",
    "version": "3.0.5",
    "require": {
        "php": "8.4.*",
        "ext-zip": "*",
        "akp/modular-forms": "4.5.1",
        "imettool/imet-core": "3.11.1",
        "laravel/framework": "13.40.0",
        "laravel/ui": "^4.6.3",
        "nativephp/desktop": "2.4.0",
        "opcodesio/log-viewer": "^3.24.2",
        "spatie/laravel-csp": "^3.31.1",
        "spatie/laravel-ignition": "^2.13"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.8.0",
        "driftingly/rector-laravel": "^2.7.3",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.14.0",
        "laravel/pint": "^1.32.1",
        "nunomaduro/collision": "^8.9.5",
        "rector/rector": "^2.8.4"
    },
    "repositories": {
        "akp/modular-forms": {
            "type": "vcs",
            "url": "https://code.europa.eu/akp/modular-forms"
        },
        "imettool/imet-core": {
            "type": "vcs",
            "url": "https://github.com/imettool/imet-core"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta",
            "php artisan log-viewer:publish",
            "@php artisan native:install --force --quiet"
        ],
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate --ansi"
        ],
        "native:build": [
            "php artisan imet:build"
        ],
        "native:publish": [
            "php artisan imet:publish"
        ],
        "native:run": [
            "php artisan native:run"
        ],
        "native:dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -k -c \"#93c5fd,#c4b5fd\" \"php artisan native:run --no-interaction\" \"npm run dev\" --names=app,vite"
        ],
        "phpstan": "./vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit 512M",
        "rector": " ./vendor/bin/rector process",
        "pint": "./vendor/bin/pint --config pint.json",
        "fix": "composer rector && composer pint",
        "notice-generator": "php notice-generator.php"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
